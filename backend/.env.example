# ===== App =====
APP_NAME=MakeMyMock-Admin
APP_ENV=development
API_V1_PREFIX=/api/v1

# ===== MongoDB =====
# Same cluster the Client backend writes to. The admin service is read-mostly
# and never owns indexes.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGO_DB_NAME=makemymock
# Catalog DB. In the Client split-deployment this is "bbd_db"; in single-DB
# setups, point it at MONGO_DB_NAME.
MONGO_QUESTIONS_DB_NAME=bbd_db

# ===== Admin credentials =====
# One admin identity, configured in env. Prefer the hashed form; generate it:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_EMAIL=admin@makemymock.local
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ===== JWT =====
# Both secrets must be >=16 chars. Rotate periodically; rotating invalidates
# every outstanding token immediately.
JWT_SECRET_KEY=change-me-min-16-chars
JWT_REFRESH_SECRET_KEY=change-me-too-min-16-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Email — Brevo (preferred for cloud deploys) =====
BREVO_API_KEY=

# ===== Email — SMTP (local dev fallback) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=MakeMyMock
SMTP_USE_TLS=true

# ===== Promo email tuning =====
PROMO_EMAIL_CONCURRENCY=5
PROMO_EMAIL_MAX_RECIPIENTS=5000
